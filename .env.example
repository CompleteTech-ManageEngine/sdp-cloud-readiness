# Local credentials: never commit or share this file. Values are literal.
# Set the exact source origin and application context before adding keys.
SDP_HOST=
# OPTIONAL SDP_API_KEY: single-key mode or deliberate directory-discovery key.
# With numbered slots, blank = slots define scope; no automatic discovery.
SDP_API_KEY=
# OPTIONAL SDP_DIRECTORY_API_KEY: directory-only recovery; never module collection.
# Blank = no separate directory-key recovery; ESM Directory needs no new key type.
SDP_DIRECTORY_API_KEY=
# OPTIONAL SDP_GLOBAL_API_KEY and SDP_GLOBAL_PORTAL_ID: explicit ESM Org access.
# In multi-key mode, leave both blank = Orguser coverage gap when applicable.
# Context ID is administrator-verified, never a slot number. See credential guide.
SDP_GLOBAL_API_KEY=
SDP_GLOBAL_PORTAL_ID=
# OPTIONAL SDP_BRAND_FILE and SDP_PREPARED_FOR: branded copies after each run.
# Brand JSON path, preset name or none; blank = CompleteTech LLC preset.
SDP_BRAND_FILE=
SDP_PREPARED_FOR=
# Slot numbers are positions, NOT portal IDs. Add 21, 22, ... if needed.

SDP_INSTANCE_01_PORTAL_ID=
SDP_INSTANCE_01_API_KEY=

